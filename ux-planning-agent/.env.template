# Azure AI Foundry — UX Planning Agent
# Copy this file to .env and fill in your values.

# Your Azure AI Foundry project endpoint
# Format: https://<hub-name>.api.azureml.ms/...
# Find it in: AI Foundry portal > Project > Overview > Endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<your-hub>.api.azureml.ms/discovery/...

# The name of your deployed model (e.g., gpt-4o, gpt-4o-mini)
# Find it in: AI Foundry portal > Deployments
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o
